generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AcademicLevel {
  UNDERGRADUATE
  MASTER
  PHD
  PROFESSOR
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  academicEmail String        @unique
  username      String        @unique
  password      String
  institution   String
  academicLevel AcademicLevel
  dateOfBirth   DateTime
  bio           String?       @db.Text
  avatar        String?       @db.Text
  coverPhoto    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  posts              Post[]
  comments           Comment[]
  likes              Like[]
  savedPosts         SavedPost[]         @relation("SavedByUsers")
  projects           Project[]
  works              Work[]
  workAccessRequests WorkAccessRequest[]
  conversations      Conversation[]      @relation("ConversationParticipants")
  messages           Message[]
  following          Follow[]            @relation("Following")
  followers          Follow[]            @relation("Followers")
  blocking           Block[]             @relation("Blocking")
  blockedBy          Block[]             @relation("BlockedBy")

  @@map("users")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants User[]    @relation("ConversationParticipants")
  messages     Message[]

  @@map("conversations")
}

model Message {
  id        String   @id @default(cuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Post {
  id        String   @id @default(cuid())
  caption   String
  image     String?
  location  String?
  hashtags  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id])
  authorId String
  comments Comment[]
  likes    Like[]
  savedBy  SavedPost[] @relation("SavedByUsers")

  @@index([authorId])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id])
  authorId String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  likes    Like[]

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model SavedPost {
  user    User     @relation("SavedByUsers", fields: [userId], references: [id])
  userId  String
  post    Post     @relation("SavedByUsers", fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  savedAt DateTime @default(now())

  @@id([userId, postId])
  @@map("saved_posts")
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  OPEN_FOR_APPLICATIONS
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  category     String
  image        String?
  status       ProjectStatus
  contactEmail String?
  contactPhone String?
  campus       String?
  city         String?
  state        String?
  country      String?       @default("Brasil")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  teamMembers TeamMember[]

  @@index([campus])
  @@index([city])
  @@index([state])
  @@index([country])
  @@map("projects")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photo     String?
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  @@map("team_members")
}

enum WorkType {
  TCC
  ARTICLE
  THESIS
  DISSERTATION
}

enum WorkVisibility {
  PUBLIC
  PRIVATE
}

enum WorkAccessStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

enum WorkArea {
  EXACT_EARTH_SCIENCES
  BIOLOGICAL_SCIENCES
  ENGINEERING
  HEALTH_SCIENCES
  AGRICULTURAL_SCIENCES
  APPLIED_SOCIAL_SCIENCES
  HUMANITIES
  LINGUISTICS_LITERATURE_ARTS
}

model Follow {
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@map("follows")
}

model Block {
  blocker   User     @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Work {
  id          String         @id @default(cuid())
  title       String
  workType    WorkType
  visibility  WorkVisibility @default(PUBLIC)
  coverImage  String?
  summary     String         @db.Text
  description String         @db.Text
  keywords    String[]
  references  String[]
  advisor     String
  institution String
  campus      String?
  city        String?
  state       String?
  country     String         @default("Brasil")
  area        WorkArea?
  department  String?
  pdfFile     String         @db.Text
  downloads   Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  accessRequests WorkAccessRequest[]

  @@index([institution])
  @@index([campus])
  @@index([city])
  @@index([state])
  @@index([country])
  @@index([area])
  @@index([authorId])
  @@map("works")
}

model WorkAccessRequest {
  id          String           @id @default(cuid())
  status      WorkAccessStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  work        Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId      String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String

  @@unique([workId, requesterId])
  @@index([workId])
  @@index([requesterId])
  @@map("work_access_requests")
}
