generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
}
enum AcademicLevel {
  UNDERGRADUATE
  MASTER
  PHD
  PROFESSOR
}

model User {
  id              String        @id @default(cuid())
  fullName        String
  academicEmail   String        @unique
  username        String        @unique
  password        String
  institution     String
  academicLevel   AcademicLevel
  dateOfBirth     DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relações
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  savedPosts      SavedPost[]   @relation("SavedByUsers")

  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  caption   String
  image     String
  location  String?
  hashtags  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  comments  Comment[]
  likes     Like[]
  savedBy   SavedPost[] @relation("SavedByUsers")

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  likes     Like[]

  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
  comment   Comment? @relation(fields: [commentId], references: [id])
  commentId String?

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model SavedPost {
  user      User     @relation("SavedByUsers", fields: [userId], references: [id])
  userId    String
  post      Post     @relation("SavedByUsers", fields: [postId], references: [id])
  postId    String
  savedAt   DateTime @default(now())

  @@id([userId, postId])
  @@map("saved_posts")
}