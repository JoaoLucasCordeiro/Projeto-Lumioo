generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
}
enum AcademicLevel {
  UNDERGRADUATE
  MASTER
  PHD
  PROFESSOR
}

model User {
  id              String        @id @default(cuid())
  fullName        String
  academicEmail   String        @unique
  username        String        @unique
  password        String
  institution     String
  academicLevel   AcademicLevel
  dateOfBirth     DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relações
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  savedPosts      SavedPost[]   @relation("SavedByUsers")
  projects        Project[]
  works           Work[]
  
  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  caption   String
  image     String
  location  String?
  hashtags  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  comments  Comment[]
  likes     Like[]
  savedBy   SavedPost[] @relation("SavedByUsers")

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  likes     Like[]

  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
  comment   Comment? @relation(fields: [commentId], references: [id])
  commentId String?

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model SavedPost {
  user      User     @relation("SavedByUsers", fields: [userId], references: [id])
  userId    String
  post      Post     @relation("SavedByUsers", fields: [postId], references: [id])
  postId    String
  savedAt   DateTime @default(now())

  @@id([userId, postId])
  @@map("saved_posts")
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  OPEN_FOR_APPLICATIONS
}

model Project {
  id            String        @id @default(cuid())
  title         String
  description   String
  image         String?
  status        ProjectStatus
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relação com o dono do projeto
  owner         User          @relation(fields: [ownerId], references: [id])
  ownerId       String

  // Relação com os membros da equipe
  teamMembers   TeamMember[]

  @@map("projects")
}

// Model para os Membros da Equipe
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photo     String?
  
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String

  @@map("team_members")
}

enum WorkType {
  TCC
  ARTICLE
  THESIS 
  DISSERTATION 
}

model Work {
  id           String   @id @default(cuid())
  title        String
  workType     WorkType
  coverImage   String?
  summary      String   @db.Text 
  description  String   @db.Text
  keywords     String[] 
  references   String[] 
  advisor      String   
  institution  String
  department   String?  
  pdfFile      String   @db.Text 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relação com o autor/uploader do trabalho
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String

  @@map("works")
}
